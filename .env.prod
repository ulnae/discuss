# 信息
VITE_APP_BUILD_INFO=production

# 后端运行时：worker = Cloudflare Worker（Discuss/worker），nestjs = server-nestjs
VITE_APP_RUNTIME=worker

# api —— Worker 自定义域名，与 WebSocket 同源，不再经过 Netlify 反代
# workers.dev 在国内被 DNS 污染，必须用自定义域；Netlify 那条
# https://ulnae.localhost.cc/discuss/api 仍可用（wrangler.toml 保留了 workers_dev），
# 作为回滚入口：改回这三行重新构建即可，不需要动 Worker。
VITE_APP_BASE_API=https://discuss-api.ulnae.dpdns.org/api

# 图片/文件前缀：消息里的 /public/xxx 直接拼在后面，末尾不要带 /api
# 回滚时改回 https://ulnae.localhost.cc/discuss
VITE_APP_API_BASE_URL=https://discuss-api.ulnae.dpdns.org

# WebSocket：与 REST 同一个域名（Cloudflare 同一条边缘，支持 WS 升级）
VITE_APP_WS_BASE_URL=https://discuss-api.ulnae.dpdns.org

# 路由基础路径
VITE_APP_BASE_URL=/discuss

# 是否mock
VITE_APP_BUILD_MODE=false

# 路由路径
VITE_BASE=/

# 标题
VITE_APP_TITLE=discuss
