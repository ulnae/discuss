# 信息
VITE_APP_BUILD_INFO=production

# 后端运行时：worker = Cloudflare Worker（Discuss/worker），nestjs = server-nestjs
VITE_APP_RUNTIME=worker

# api —— 经 Netlify 反代（与 tools 共用站点，靠 /discuss 前缀区分），国内可达
VITE_APP_BASE_API=https://ulnae.localhost.cc/discuss/api

# 图片/文件前缀：消息里的 /public/xxx 直接拼在后面，末尾不要带 /api
VITE_APP_API_BASE_URL=https://ulnae.localhost.cc/discuss

# WebSocket：走 Worker 的自定义域名（Cloudflare 同一条边缘，支持 WS 升级）
# workers.dev 在国内被 DNS 污染，直连必然失败，必须用下面这个自定义域
VITE_APP_WS_BASE_URL=https://discuss-api.ulnae.dpdns.org

# 路由基础路径
VITE_APP_BASE_URL=/discuss

# 是否mock
VITE_APP_BUILD_MODE=false

# 路由路径
VITE_BASE=/

# 标题
VITE_APP_TITLE=discuss
